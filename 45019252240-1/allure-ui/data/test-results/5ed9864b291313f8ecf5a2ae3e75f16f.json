ений не принадлежит тестовому объекту.\";\nКонецЕсли;\nИначе\nВызватьИсключение \"Неизвестный регистр сообщений.\";\nКонецЕсли;\nДля Каждого ТекущийКлюч Из СтрРазделить(Ключ + \",\" + БазовыйКлюч + \"-3\", \",\") Цикл\nСообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);\nСообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);\nСообщения.Записать();\nОчередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795349657804,"stop":1795349658387,"duration":583,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795349657804,"stop":1795349658387,"duration":583,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795349633312,"stop":1795349658387,"duration":25075,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","setup":[{"id":"7d5a5b46612c18bbf391e8980c281ef5","type":"before","name":"Дано Я подключаю клиент тестирования с параметрами:","status":"passed","steps":[{"link":{"used":true,"missed":false,"id":"7f18e5661d242eba68b76536576f0a06","originalFileName":"c2b9953e-4369-49af-8c28-fdf63e11fef9-attachment.csv","ext":".csv","contentType":"text/csv","contentLength":224,"name":"table"},"type":"attachment"}],"duration":486},{"id":"66f41d77809dfbd3c870dbf62c5ef224","type":"before","name":"И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную \"ИдентификаторДанных\"","status":"passed","steps":[],"duration":3},{"id":"f455d7d0ddf3e1a1dd9d60332f2e41a3","type":"before","name":"И Я запоминаю значение выражения '\"VA-\" + Контекст.ИдентификаторДанных' в переменную \"КлючЗаписи\"","status":"passed","steps":[],"duration":3},{"id":"ca5c04ccc5e33ff13f9197f3d536728a","type":"before","name":"И Я запоминаю значение выражения 'Контекст.КлючЗаписи + \"-3\"' в переменную \"КлючКонтроля\"","status":