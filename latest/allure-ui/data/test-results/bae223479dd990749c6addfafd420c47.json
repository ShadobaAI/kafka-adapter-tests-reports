едь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795386306117,"stop":1795386306676,"duration":559,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795386306117,"stop":1795386306676,"duration":559,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","setup":[{"id":"665554a6ed5a4694761e40f9e7704e23","type":"before","name":"Дано Я подключаю клиент тестирования с параметрами:","status":"passed","steps":[{"link":{"used":true,"missed":false,"id":"88f7c14682e4639fc74f611182b755db","originalFileName":"b1cf114d-fbef-43ed-ba8e-0eff45cee2ac-attachment.csv","ext":".csv","contentType":"text/csv","contentLength":224,"name":"table"},"type":"attachment"}],"duration":378},{"id":"65e66216a63354448bcd2fadac329f2c","type":"before","name":"И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную \"ИдентификаторДанных\"","status":"passed","steps":[],"duration":3},{"id":"f8dc2b7f1f1a093bd2c3caba68bf887c","type":"before","name":"И Я запоминаю значение выражения '\"VA-\" + Контекст.ИдентификаторДанных' в переменную \"КлючЗаписи\"","status":"passed","steps":[],"duration":3},{"id":"00adb518d68c675cd2eb4c3a01066de4","type":"before","name":"И Я запоминаю значение выражения 'Контекст.КлючЗаписи + \"-3\"' в переменную \"КлючКонтроля\"","status":"passed","steps":[],"duration":3},{"id":"6f59ff00fe2e4de451ded4dc6a39ec9d","type":"before","name":"И Я запоминаю значение выражения 'Контекст.КлючЗаписи' в переменную \"ИмяДанных\"","status":"passed","steps":[],"duration":3},{"id":"135e098001da8d99a47246016b52ef77","type":"before","name":"И я вывожу значение переменной \"КлючЗаписи\"","status":"passed","steps":[],"duration":1},{"id":"0626d90be7c8be282dfab5f0eba51051","type":"before","name":"И я вывожу значение переменной \"КлючКонтроля\"","sta