\nИначеЕсли \"кфкВходящиеСообщения\" = \"кфкВходящиеСообщения\" Тогда\nМенеджер = РегистрыСведений.кфкВходящиеСообщения;\nЕсли Ключ <> БазовыйКлюч Тогда\nВызватьИсключение \"Ключ входящих сообщений не принадлежит тестовому объекту.\";\nКонецЕсли;\nИначе\nВызватьИсключение \"Неизвестный регистр сообщений.\";\nКонецЕсли;\nДля Каждого ТекущийКлюч Из СтрРазделить(Ключ + \",\" + БазовыйКлюч + \"-3\", \",\") Цикл\nСообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);\nСообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);\nСообщения.Записать();\nОчередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795349276200,"stop":1795349276606,"duration":406,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795349276200,"stop":1795349276606,"duration":406,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","setup":[{"id":"b62fd6ed04f440629b4a035b6429a710","type":"before","name":"Дано Я подключаю клиент тестирования с параметрами:","status":"passed","steps":[{"link":{"used":true,"missed":false,"id":"a741846d536b52bd85faf8a0d97d4297","originalFileName":"20a31c28-0fd3-47c9-9a6f-e8b639d80d22-attachment.csv","ext":".csv","contentType":"text/csv","contentLength":224,"name":"table"},"type":"attachment"}],"duration":618},{"id":"728a74ec9c1a5ce8e77edcf488edb9b5","type":"before","name":"И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную \"ИдентификаторДанных\"","status":"passed","steps":[],"duration":2},{"id":"dffcc57300065eea4dbf2931e8956f5f","type":"before","name":"И Я запоминаю значение выражения '\"VA-\" + Контекст.ИдентификаторДанных' в переменную \"КлючЗаписи\"","status":"passed","steps":[],"duration":2},{"id":"2e019f13a4a601355e18b95b73307feb","type":"before","name":"И Я запоминаю значение выражения 'Кон