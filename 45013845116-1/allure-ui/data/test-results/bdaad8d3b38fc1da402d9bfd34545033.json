ений не принадлежит тестовому объекту.\";\nКонецЕсли;\nИначе\nВызватьИсключение \"Неизвестный регистр сообщений.\";\nКонецЕсли;\nДля Каждого ТекущийКлюч Из СтрРазделить(Ключ + \",\" + БазовыйКлюч + \"-3\", \",\") Цикл\nСообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);\nСообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);\nСообщения.Записать();\nОчередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795345652172,"stop":1795345652605,"duration":433,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795345652172,"stop":1795345652605,"duration":433,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795345625485,"stop":1795345652605,"duration":27120,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","setup":[{"id":"754c039e8a94ed382a9f419dc65460b3","type":"before","name":"Дано Я подключаю клиент тестирования с параметрами:","status":"passed","steps":[{"link":{"used":true,"missed":false,"id":"51f14f348b6e725ce70ed82b0bb3548c","originalFileName":"4922c29f-b140-4078-8f4e-108ccfcf88dd-attachment.csv","ext":".csv","contentType":"text/csv","contentLength":224,"name":"table"},"type":"attachment"}],"duration":453},{"id":"0bf7e347a86482730311f1023550b562","type":"before","name":"И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную \"ИдентификаторДанных\"","status":"passed","steps":[],"duration":2},{"id":"87b0d0423db6461eab39b5d9b5fb8cfa","type":"before","name":"И Я запоминаю значение выражения '\"VA-\" + Контекст.ИдентификаторДанных' в переменную \"КлючЗаписи\"","status":"passed","steps":[],"duration":2},{"id":"22b62b16adf8336c0f72b1fdd8cf9a9e","type":"before","name":"И Я запоминаю значение выражения 'Контекст.КлючЗаписи + \"-3\"' в переменную \"КлючКонтроля\"","status":