ка на сервере","status":"passed","steps":[],"parameters":[{"name":"Парам1","value":"Идентификатор = Новый УникальныйИдентификатор(\"cf08fa6c-8ee4-499c-b183-11c6d6ac22db\");\nБазовыйКлюч = \"VA-\" + Строка(Идентификатор);\nКлюч = \"VA-cf08fa6c-8ee4-499c-b183-11c6d6ac22db\";\nЕсли \"кфкИсходящиеСообщения\" = \"кфкИсходящиеСообщения\" Тогда\nМенеджер = РегистрыСведений.кфкИсходящиеСообщения;\nЕсли Ключ <> БазовыйКлюч Тогда\nСсылка = Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Идентификатор);\nКлючиОбъекта = кфкОбработкаСобытийСлужебный.КлючЗаписиИсходящихСообщений(Ссылка);\nЕсли КлючиОбъекта = Неопределено Или КлючиОбъекта.Найти(Ключ) = Неопределено Тогда\nВызватьИсключение \"Ключ исходящих сообщений не принадлежит тестовому объекту.\";\nКонецЕсли;\nКонецЕсли;\nИначеЕсли \"кфкИсходящиеСообщения\" = \"кфкВходящиеСообщения\" Тогда\nМенеджер = РегистрыСведений.кфкВходящиеСообщения;\nЕсли Ключ <> БазовыйКлюч Тогда\nВызватьИсключение \"Ключ входящих сообщений не принадлежит тестовому объекту.\";\nКонецЕсли;\nИначе\nВызватьИсключение \"Неизвестный регистр сообщений.\";\nКонецЕсли;\nДля Каждого ТекущийКлюч Из СтрРазделить(Ключ + \",\" + БазовыйКлюч + \"-3\", \",\") Цикл\nСообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);\nСообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);\nСообщения.Записать();\nОчередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795340230187,"stop":1795340230777,"duration":590,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795340230187,"stop":1795340230777,"duration":590,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","setup":[{"id":"ba2fb572736db72566c9620989809d78","type":"before","name":"Дано Я подключаю клиент тестирования с параметрами:","status":"passed","steps":[{"link":{"used":t