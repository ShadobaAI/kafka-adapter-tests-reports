бщений не принадлежит тестовому объекту.\";\nКонецЕсли;\nИначе\nВызватьИсключение \"Неизвестный регистр сообщений.\";\nКонецЕсли;\nДля Каждого ТекущийКлюч Из СтрРазделить(Ключ + \",\" + БазовыйКлюч + \"-3\", \",\") Цикл\nСообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);\nСообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);\nСообщения.Записать();\nОчередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795693053492,"stop":1795693054084,"duration":592,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795693053492,"stop":1795693054084,"duration":592,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795693027839,"stop":1795693054084,"duration":26245,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","setup":[{"id":"a1e11716667cb110e951f8ff91e80258","type":"before","name":"Дано Я подключаю клиент тестирования с параметрами:","status":"passed","steps":[{"link":{"used":true,"missed":false,"id":"c19131975572ed3ae5359a750fba576d","originalFileName":"8543e578-20cb-4a34-b004-6c3cb715032b-attachment.csv","ext":".csv","contentType":"text/csv","contentLength":224,"name":"table"},"type":"attachment"}],"duration":618},{"id":"08f660a125f85e4a23e009c279287d6b","type":"before","name":"И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную \"ИдентификаторДанных\"","status":"passed","steps":[],"duration":3},{"id":"c4ef3052ddc6e7ab3f6efe572fd8264a","type":"before","name":"И Я запоминаю значение выражения '\"VA-\" + Контекст.ИдентификаторДанных' в переменную \"КлючЗаписи\"","status":"passed","steps":[],"duration":3},{"id":"d52d50dc84e92eed25fe3aca4e26b9f6","type":"before","name":"И Я запоминаю значение выражения 'Контекст.КлючЗаписи + \"-3\"' в переменную \"КлючКонтроля\"","status