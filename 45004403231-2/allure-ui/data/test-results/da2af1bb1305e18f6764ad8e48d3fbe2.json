иеСообщения\" \"$ИдентификаторДанных$\" \"$КлючЗаписи$\"","status":"passed","steps":[{"stepId":"5e86299dc3347da02311d70fb292eaab","name":"И я выполняю код встроенного языка на сервере","status":"passed","steps":[],"parameters":[{"name":"Парам1","value":"Идентификатор = Новый УникальныйИдентификатор(\"e054a027-9e04-4580-8fda-030c7d17a27e\");\nБазовыйКлюч = \"VA-\" + Строка(Идентификатор);\nКлюч = \"VA-e054a027-9e04-4580-8fda-030c7d17a27e\";\nЕсли \"кфкИсходящиеСообщения\" = \"кфкИсходящиеСообщения\" Тогда\nМенеджер = РегистрыСведений.кфкИсходящиеСообщения;\nЕсли Ключ <> БазовыйКлюч Тогда\nСсылка = Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Идентификатор);\nКлючиОбъекта = кфкОбработкаСобытийСлужебный.КлючЗаписиИсходящихСообщений(Ссылка);\nЕсли КлючиОбъекта = Неопределено Или КлючиОбъекта.Найти(Ключ) = Неопределено Тогда\nВызватьИсключение \"Ключ исходящих сообщений не принадлежит тестовому объекту.\";\nКонецЕсли;\nКонецЕсли;\nИначеЕсли \"кфкИсходящиеСообщения\" = \"кфкВходящиеСообщения\" Тогда\nМенеджер = РегистрыСведений.кфкВходящиеСообщения;\nЕсли Ключ <> БазовыйКлюч Тогда\nВызватьИсключение \"Ключ входящих сообщений не принадлежит тестовому объекту.\";\nКонецЕсли;\nИначе\nВызватьИсключение \"Неизвестный регистр сообщений.\";\nКонецЕсли;\nДля Каждого ТекущийКлюч Из СтрРазделить(Ключ + \",\" + БазовыйКлюч + \"-3\", \",\") Цикл\nСообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);\nСообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);\nСообщения.Записать();\nОчередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795340214014,"stop":1795340214614,"duration":600,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795340214014,"stop":1795340214614,"duration":600,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","