ик.ПолучитьСсылку(Идентификатор);\nКлючиОбъекта = кфкОбработкаСобытийСлужебный.КлючЗаписиИсходящихСообщений(Ссылка);\nЕсли КлючиОбъекта = Неопределено Или КлючиОбъекта.Найти(Ключ) = Неопределено Тогда\nВызватьИсключение \"Ключ исходящих сообщений не принадлежит тестовому объекту.\";\nКонецЕсли;\nКонецЕсли;\nИначеЕсли \"кфкИсходящиеСообщения\" = \"кфкВходящиеСообщения\" Тогда\nМенеджер = РегистрыСведений.кфкВходящиеСообщения;\nЕсли Ключ <> БазовыйКлюч Тогда\nВызватьИсключение \"Ключ входящих сообщений не принадлежит тестовому объекту.\";\nКонецЕсли;\nИначе\nВызватьИсключение \"Неизвестный регистр сообщений.\";\nКонецЕсли;\nДля Каждого ТекущийКлюч Из СтрРазделить(Ключ + \",\" + БазовыйКлюч + \"-3\", \",\") Цикл\nСообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);\nСообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);\nСообщения.Записать();\nОчередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795345750497,"stop":1795345750860,"duration":363,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795345750497,"stop":1795345750860,"duration":363,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","setup":[{"id":"3adbea7e762253d6b2e4d8b96383e5f7","type":"before","name":"Дано Я подключаю клиент тестирования с параметрами:","status":"passed","steps":[{"link":{"used":true,"missed":false,"id":"bd265c52e02c2e494b96aa13e2f3320b","originalFileName":"83f8642e-8293-41ae-91ee-20b9061eb147-attachment.csv","ext":".csv","contentType":"text/csv","contentLength":224,"name":"table"},"type":"attachment"}],"duration":454},{"id":"29486f9546880b5ede9cf15710c76282","type":"before","name":"И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную \"ИдентификаторДанных\"","status":"passed","steps":[],"duration":2},{"id"