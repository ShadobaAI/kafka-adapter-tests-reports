ений не принадлежит тестовому объекту.\";\nКонецЕсли;\nИначе\nВызватьИсключение \"Неизвестный регистр сообщений.\";\nКонецЕсли;\nДля Каждого ТекущийКлюч Из СтрРазделить(Ключ + \",\" + БазовыйКлюч + \"-3\", \",\") Цикл\nСообщения = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(Менеджер);\nСообщения.Отбор.КлючЗаписи.Установить(ТекущийКлюч);\nСообщения.Записать();\nОчередь = кфкОбщегоНазначенияСлужебный.СоздатьНаборЗаписей(РегистрыСведений.кфкОчередьПотоков);\nОчередь.Отбор.Ключ.Установить(ТекущийКлюч);\nОчередь.Записать();\nКонецЦикла;","hidden":false,"excluded":false,"masked":false}],"start":1795330229481,"stop":1795330229857,"duration":376,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795330229481,"stop":1795330229857,"duration":376,"type":"step","hasSimilarErrorInSubSteps":false}],"parameters":[],"start":1795330204619,"stop":1795330229857,"duration":25238,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"environment":"default","setup":[{"id":"71ed1fb05fa04da7a590aa5de6eda13e","type":"before","name":"Дано Я подключаю клиент тестирования с параметрами:","status":"passed","steps":[{"link":{"used":true,"missed":false,"id":"b768a847c86a67583de6c008e980f938","originalFileName":"e273258f-a43d-43f4-b788-74e8e1e752be-attachment.csv","ext":".csv","contentType":"text/csv","contentLength":224,"name":"table"},"type":"attachment"}],"duration":427},{"id":"d7767e4b23b2b21335f4b6f84aa68103","type":"before","name":"И Я запоминаю значение выражения 'Строка(Новый УникальныйИдентификатор)' в переменную \"ИдентификаторДанных\"","status":"passed","steps":[],"duration":3},{"id":"162fdc08ef66d344e3f44dcaee6a4a0f","type":"before","name":"И Я запоминаю значение выражения '\"VA-\" + Контекст.ИдентификаторДанных' в переменную \"КлючЗаписи\"","status":"passed","steps":[],"duration":2},{"id":"455560b648c0d0a5c5a402f0069c1408","type":"before","name":"И Я запоминаю значение выражения 'Контекст.КлючЗаписи + \"-3\"' в переменную \"КлючКонтроля\"","status":